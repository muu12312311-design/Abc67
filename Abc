-- ================================================================
-- 2. ระบบสแกนเรืองแสงมองเห็นอาวุธบนพื้น (Item Highlight)
-- ================================================================
local function applyHighlightToWeapons()
	for _, item in pairs(Workspace:GetDescendants()) do
		-- หาวัตถุที่เป็น Tool ที่วางบนพื้น (ไม่รวมที่ผู้เล่นถืออยู่)
		if item:IsA("Tool") and not item:IsDescendantOf(player.Character) then
			if not item:FindFirstChild("WeaponHighlight") then
				local highlight = Instance.new("Highlight")
				highlight.Name = "WeaponHighlight"
				highlight.FillColor = Color3.fromRGB(0, 255, 255) -- สีฟ้าเรืองแสง
				highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				highlight.FillTransparency = 0.5
				highlight.OutlineTransparency = 0
				highlight.Parent = item
			end
		end
	end
end

-- ลูปสแกนหาอาวุธใหม่ทุกๆ 3 วินาที
task.spawn(function()
	while true do
		applyHighlightToWeapons()
		task.wait(3)
	end
end)


-- ================================================================
-- 3. ระบบยิงด้วย Raycast ตรวจจับโดนหัว (Headshot System)
-- ================================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	-- เมื่อผู้เล่นคลิกซ้าย
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local character = player.Character
		if not character or not character:FindFirstChild("Head") then return end
		
		local origin = character.Head.Position
		local targetPos = mouse.Hit.Position
		local direction = (targetPos - origin).Unit * 500 -- ระยะคำนวณ Raycast
		
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = {character} -- เว้นตัวผู้เล่นเอง
		
		local result = Workspace:Raycast(origin, direction, raycastParams)
		
		if result and result.Instance then
			local hitPart = result.Instance
			local hitChar = hitPart.Parent
			local humanoid = hitChar:FindFirstChildOfClass("Humanoid")
			
			-- กรณีชิ้นส่วนซ้อนอยู่ใน Model ย่อย
			if not humanoid and hitChar.Parent then
				hitChar = hitChar.Parent
				humanoid = hitChar:FindFirstChildOfClass("Humanoid")
			end
			
			-- ตรวจจับการยิงโดนเป้าหมาย
			if humanoid and hitChar.Name ~= player.Name then
				if hitPart.Name == "Head" then
					print("ยิงเข้าหัว! (Headshot Detect): " .. hitChar.Name)
					-- ตรงนี้สามารถใส่ระบบ Effect เสียง หรือ Damage เพิ่มเติมได้
				else
					print("ยิงโดนตัว: " .. hitChar.Name)
				end
			end
		end
	end
end)
